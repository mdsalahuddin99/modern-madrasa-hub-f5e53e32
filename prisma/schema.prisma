// ===================================================
// Prisma Schema — মাদ্রাসা ডিরেক্টরি প্রজেক্ট (MVP)
// Database: PostgreSQL
// ===================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Auth Models (NextAuth.js v5) ─────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── User & Roles ─────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  INSTITUTION_ADMIN
  USER
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  hashedPassword     String?
  role               UserRole  @default(USER)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  madrasas            Madrasa[]             // Admin of these madrasas
  reviews             Review[]
  passwordResetTokens PasswordResetToken[]
  verificationsDone   InstitutionVerification[] @relation("VerifierRelation")
  performanceAnalytics PerformanceAnalytics[]

  @@index([role])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   // SHA-256 hashed
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ─── Location Directory ───────────────────────────

model Division {
  id        String     @id @default(cuid())
  nameBn    String
  nameEn    String
  slug      String     @unique
  districts District[]
  madrasas  Madrasa[]
}

model District {
  id         String     @id @default(cuid())
  divisionId String
  nameBn     String
  nameEn     String
  slug       String     @unique
  division   Division   @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  thanas     Thana[]
  madrasas   Madrasa[]

  @@index([divisionId])
}

model Thana {
  id         String     @id @default(cuid())
  districtId String
  nameBn     String
  nameEn     String
  slug       String     @unique
  district   District   @relation(fields: [districtId], references: [id], onDelete: Cascade)
  unions     Union[]
  madrasas   Madrasa[]

  @@index([districtId])
}

model Union {
  id         String     @id @default(cuid())
  thanaId    String
  nameBn     String
  nameEn     String
  slug       String     @unique
  thana      Thana      @relation(fields: [thanaId], references: [id], onDelete: Cascade)
  madrasas   Madrasa[]

  @@index([thanaId])
}

// ─── Institution (Multi-tenant Root) ──────────────

enum MadrasaStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum MadrasaCategory {
  JAMIA
  ALIA
  MADRASA
  HIFZ
  NURANI
  MOHILA
  ISLAMIC_SCHOOL
  HIGHER_EDU
  OTHERS
}

enum MadrasaBoard {
  BEFAQ
  GAWHARDANGA
  ITTEHADUL
  AZAD_DEENI
  TANZIMUL
  JATIYA_DEENI
  NONE
}

model Madrasa {
  id               String          @id @default(cuid())
  slug             String          @unique // e.g., baitul-mukarram
  name             String
  category         MadrasaCategory
  board            MadrasaBoard    @default(NONE)
  established      String?
  students         Int             @default(0)
  teachers         Int             @default(0)
  description      String?         @db.Text
  address          String
  area             String?
  phone            String
  email            String
  website          String?
  
  // Custom Domain Support
  customDomain     String?         @unique 

  // Location Hierarchy
  divisionId       String
  districtId       String
  thanaId          String
  unionId          String?
  
  division         Division        @relation(fields: [divisionId], references: [id])
  district         District        @relation(fields: [districtId], references: [id])
  thana            Thana           @relation(fields: [thanaId], references: [id])
  union            Union?          @relation(fields: [unionId], references: [id])

  // Profile Visuals
  image            String?
  bannerImage      String?
  tagline          String?
  history          String?         @db.Text
  mission          String?         @db.Text
  vision           String?         @db.Text
  principalName    String?
  principalRole    String?
  principalMessage String?         @db.Text
  
  // Stats
  alumniCount      String?
  notableAlumni    String?         @db.Text
  rating           Float           @default(0)
  featured         Boolean         @default(false)
  status           MadrasaStatus   @default(PENDING)

  // SEO
  metaTitle        String?
  metaDescription  String?
  metaKeywords     String?

  // Admission (Basic)
  admissionOpen     Boolean @default(false)
  admissionFile     String?
  admissionFileType String?
  admissionRules    String[] @default([])

  // Ownership
  directorId    String
  director      User           @relation(fields: [directorId], references: [id])

  // Relations
  facilities          Facility[]
  galleryImages       GalleryImage[]
  staffList           Staff[]
  reviews             Review[]
  subscriptions       Subscription[]
  contents            InstitutionContent[]
  verification        InstitutionVerification?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([directorId])
  @@index([divisionId, districtId, thanaId])
  @@index([status, category])
  @@index([status, board])
  @@index([featured, status])
  @@index([name])
}

// ─── Institution Verification ─────────────────────

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model InstitutionVerification {
  id              String             @id @default(cuid())
  madrasaId       String             @unique
  status          VerificationStatus @default(PENDING)
  documentUrl     String?            // Trade license / Board registration PDF
  documentType    String?
  notes           String?            @db.Text
  submittedAt     DateTime           @default(now())
  verifiedAt      DateTime?
  verifiedBy      String?
  
  madrasa         Madrasa            @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  verifier        User?              @relation("VerifierRelation", fields: [verifiedBy], references: [id])

  @@index([status])
}

// ─── Institution Profile Content ──────────────────

model Facility {
  id        String  @id @default(cuid())
  name      String
  icon      String?
  madrasaId String
  madrasa   Madrasa @relation(fields: [madrasaId], references: [id], onDelete: Cascade)

  @@index([madrasaId])
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  order     Int      @default(0)
  madrasaId String
  madrasa   Madrasa  @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([madrasaId])
}

enum StaffType {
  PRINCIPAL
  TEACHER
  STAFF
}

model Staff {
  id          String    @id @default(cuid())
  name        String
  designation String
  type        StaffType @default(TEACHER)
  department  String?
  image       String?
  bio         String?   @db.Text
  order       Int       @default(0)
  madrasaId   String
  madrasa     Madrasa   @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([madrasaId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      @default(5)
  comment   String?  @db.Text
  userId    String
  madrasaId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  madrasa   Madrasa  @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([madrasaId])
}

enum ContentType {
  NEWS
  NOTICE
  EVENT
}

model InstitutionContent {
  id          String      @id @default(cuid())
  madrasaId   String
  type        ContentType
  title       String
  slug        String
  content     String      @db.Text
  imageUrl    String?
  fileUrl     String?     // PDF for notice etc.
  eventDate   DateTime?   // specific to EVENT
  isPublished Boolean     @default(true)
  
  madrasa     Madrasa     @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([madrasaId, slug])
  @@index([madrasaId, type, isPublished])
}

// ─── SaaS Subscription & Feature Access ───────────

model SystemFeature {
  id          String   @id @default(cuid())
  code        String   @unique // e.g. "NEWS", "GALLERY", "ADMISSION"
  name        String
  description String?
  active      Boolean  @default(true)
  
  planFeatures PlanFeature[]
}

model SubscriptionPlan {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  durationYear Int      @default(1)
  pricePerYear Int
  totalPrice   Int
  active       Boolean  @default(true)

  planFeatures  PlanFeature[]
  subscriptions Subscription[]
}

model PlanFeature {
  planId    String
  featureId String
  
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature   SystemFeature    @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
  @@index([featureId])
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id             String               @id @default(cuid())
  madrasaId      String
  planId         String
  status         SubscriptionStatus   @default(PENDING)
  
  startDate      DateTime?
  endDate        DateTime?
  reviewNote     String?
  
  madrasa        Madrasa              @relation(fields: [madrasaId], references: [id], onDelete: Cascade)
  plan           SubscriptionPlan     @relation(fields: [planId], references: [id])
  payments       PaymentTransaction[]
  history        SubscriptionHistory[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([madrasaId])
  @@index([status, endDate])
}

enum SubscriptionAction {
  CREATED
  ACTIVATED
  RENEWED
  UPGRADED
  CANCELLED
  EXPIRED
}

model SubscriptionHistory {
  id             String             @id @default(cuid())
  subscriptionId String
  action         SubscriptionAction
  notes          String?
  createdAt      DateTime           @default(now())
  
  subscription   Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

// ─── Payment System ───────────────────────────────

enum PaymentGateway {
  MANUAL
  SSLCOMMERZ
  AAMARPAY
}

enum PaymentStatus {
  INITIATED
  PROCESSING
  SUCCESS
  FAILED
}

model PaymentTransaction {
  id             String         @id @default(cuid())
  subscriptionId String
  amount         Decimal
  currency       String         @default("BDT")
  gateway        PaymentGateway
  transactionId  String?        // From gateway or manually entered
  payerPhone     String?
  status         PaymentStatus  @default(INITIATED)
  webhookData    Json?          // Dump webhook response here
  
  subscription   Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([subscriptionId])
  @@index([transactionId])
}

// ─── Super Admin CMS ──────────────────────────────

model StaticPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     String   @db.Text
  isPublished Boolean  @default(true)
  metaTitle   String?
  metaDesc    String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlatformSetting {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "HOME_BANNER", "FAQ"
  value       Json
  description String?
  updatedAt   DateTime @updatedAt
}

// ─── Analytics ────────────────────────────────────

model PerformanceAnalytics {
  id                     String   @id @default(cuid())
  sessionId              String
  userId                 String
  sessionDuration        Int      @default(0)
  pageLoadTime           Int?
  firstContentfulPaint   Int?
  largestContentfulPaint Int?
  timeToInteractive      Int?
  totalBlockingTime      Int?
  cumulativeLayoutShift  Float?
  interactionCount       Int      @default(0)
  errorCount             Int      @default(0)
  userAgent              String?
  timestamp              DateTime @default(now())
  
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
}
